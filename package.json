{
  "name": "whatsapp-group-manager",
  "version": "1.0.0",
  "description": "Local desktop manager for WhatsApp groups with multiple admin accounts, rotation and pacing.",
  "main": "electron/main.js",
  "author": "WhatsApp Group Manager",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win"
  },
  "dependencies": {
    "@whiskeysockets/baileys": "6.7.24",
    "bcryptjs": "^2.4.3",
    "pino": "^9.5.0",
    "qrcode": "^1.5.4",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.whatsapp.groupmanager",
    "productName": "WhatsApp Group Manager",
    "asar": false,
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
